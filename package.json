{
  "name": "dsh-spend-wallpaper",
  "version": "1.0.1",
  "description": "DSH Web UI wallpaper driven by the DeepSeek balance spent in the last hour, with per-tier uploadable scenes and a draggable quick panel.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-spend-wallpaper": "./bin/dsh-spend-wallpaper.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./terminal": "./lib/terminal-cli.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "LICENSE-ASSETS",
    "docs",
    "examples"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "balance",
    "cost",
    "usage",
    "web-ui"
  ],
  "author": "sleeping112",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleeping112/dsh-spend-wallpaper.git"
  },
  "homepage": "https://github.com/sleeping112/dsh-spend-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/sleeping112/dsh-spend-wallpaper/issues"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "build": "node scripts/build-client.mjs",
    "terminal": "node bin/dsh-spend-wallpaper.mjs",
    "demo": "node bin/dsh-spend-wallpaper.mjs render --tier 2 --once",
    "prepublishOnly": "npm test && node scripts/build-client.mjs"
  }
}
