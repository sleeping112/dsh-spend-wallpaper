{
  "name": "dsh-spend-wallpaper",
  "version": "0.6.0",
  "description": "DeepSeek Harness 插件：按最近 1 小时余额消耗切换静态/动态壁纸。Wallpaper that follows the DeepSeek balance spent in the last hour.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-spend-wallpaper": "./bin/dsh-spend-wallpaper.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./terminal": "./lib/terminal-cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-ASSETS",
    "docs",
    "examples"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "余额壁纸",
    "summary": "按最近 1 小时消耗的 DeepSeek 余额切换壁纸（内置 5 档动态/静态素材包，支持自定义素材）。",
    "categories": [
      "Web UI",
      "观测",
      "娱乐"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "permissions": {
      "network": [
        "https://api.deepseek.com"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "balance",
    "cost",
    "web-ui"
  ],
  "author": "dsh-spend-wallpaper contributors",
  "license": "MIT",
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "build": "node scripts/build-client.mjs",
    "check:pack": "node scripts/pack-check.mjs",
    "gen:assets": "python scripts/gen-assets.py",
    "terminal": "node bin/dsh-spend-wallpaper.mjs",
    "demo": "node bin/dsh-spend-wallpaper.mjs render --tier 2 --once",
    "prepublishOnly": "npm test && node scripts/build-client.mjs && node scripts/pack-check.mjs"
  }
}
